*.axf
*.bin
*.hex
*.elf
*.out
*.srec
*.map
*.lst
*.htm
*.crf
*.dep
*.o
*.d
*.lnp
*.scvd
*.bak
*.ini

# Keil 工程配置缓存
*.uvopt
*.uvoptx
*.uvguix*
*.uvprojx.bak
*.JLinkScript

# Debug/Release 输出目录（根据你工程里的文件夹名调整）
Debug/
Release/
Output/
Listings/
Objects/
MDK-ARM/Config/
MDK-ARM/Listings/
MDK-ARM/Objects/

# ==============================================
# 2. STM32CubeMX 生成的临时文件
# ==============================================
